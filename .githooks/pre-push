#!/bin/sh
# Pre-push gate: runs lint + Worker type-check + production build before anything is pushed to main.
# - Only pushes to refs/heads/main are checked (feature branches and tags pass through).
# - Pushes that only touch docs (*.md, .gitignore) are skipped.
# - The checks run against the current working tree, so commit everything you intend to push.
# - Emergency bypass: git push --no-verify

ZERO=0000000000000000000000000000000000000000
run_checks=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue # deleting the branch: nothing to check

  if [ "$remote_sha" = "$ZERO" ]; then
    run_checks=1 # main does not exist on the remote yet: check everything
    continue
  fi

  # If the remote commit is unknown locally, the diff fails and we play it safe by checking.
  if ! changed=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null); then
    run_checks=1
    continue
  fi

  if printf '%s\n' "$changed" | grep -v -E '(^$|\.md$|^\.gitignore$)' >/dev/null; then
    run_checks=1
  fi
done

if [ "$run_checks" -eq 0 ]; then
  exit 0
fi

echo "pre-push: pushing to main - running lint + type-check + production build (skip with: git push --no-verify)"

if ! npm run lint; then
  echo "pre-push: lint failed - push aborted" >&2
  exit 1
fi

if ! npm run typecheck; then
  echo "pre-push: Worker type-check failed - push aborted" >&2
  exit 1
fi

if ! npm run build; then
  echo "pre-push: build failed - push aborted" >&2
  exit 1
fi

echo "pre-push: all checks passed"
